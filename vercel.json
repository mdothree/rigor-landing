{
  "version": 2,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/resume",
      "destination": "https://resume.rigor.design",
      "permanent": true
    },
    {
      "source": "/cover",
      "destination": "https://cover.rigor.design",
      "permanent": true
    },
    {
      "source": "/linkedin",
      "destination": "https://linkedin.rigor.design",
      "permanent": true
    },
    {
      "source": "/interview",
      "destination": "https://interview.rigor.design",
      "permanent": true
    },
    {
      "source": "/salary",
      "destination": "https://salary.rigor.design",
      "permanent": true
    },
    {
      "source": "/portfolio",
      "destination": "https://portfolio.rigor.design",
      "permanent": true
    },
    {
      "source": "/networking",
      "destination": "https://networking.rigor.design",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    }
  ]
}
